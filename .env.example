# ---- required ----

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Encrypts users' Kalshi private keys at rest.
# Generate with: python -m kbot.tools genkey
# Losing this means every stored credential becomes unreadable.
MASTER_KEY=

# Telegram user IDs allowed to mint access keys. Space or comma separated.
ADMIN_IDS=

# ---- Kalshi ----

# Point at Kalshi's demo environment while you are setting things up.
KALSHI_DEMO=false

# Platform credentials, used ONLY for the shared market-data websocket.
# Orders are always placed with each user's own key, never this one.
# Without these the bot still works, but falls back to REST order-book polling.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/market-data.pem
# ...or inline instead of a path (use \n for newlines):
# KALSHI_PRIVATE_KEY=

# Series tickers for the 15-minute up/down markets. Kalshi changes these from
# time to time — check with `python -m kbot.tools markets` and override here.
# KALSHI_SERIES={"BTC":"KXBTCD","ETH":"KXETHD","SOL":"KXSOLD"}

# Optional spot reference feed (Coinbase product IDs). Strategy input only.
# SPOT_PRODUCTS={"BTC":"BTC-USD","ETH":"ETH-USD"}

# ---- engine ----

DB_PATH=./data/kbot.sqlite3
SCAN_INTERVAL_S=1.0
DISCOVERY_INTERVAL_S=20
ORDERBOOK_POLL_INTERVAL_S=2

# Set to false to let anyone use the bot without redeeming an access key.
REQUIRE_ACCESS_KEY=true

# ---- payments ----

# "manual" (default) shows a static address and an admin runs /confirm.
# "nowpayments" creates invoices and issues keys automatically on confirmation.
PAYMENT_PROVIDER=manual

# Manual mode: the addresses buyers send to.
# MANUAL_PAY_ADDRESSES={"BTC":"bc1...","ETH":"0x...","USDT":"T...","SOL":"..."}

# NOWPayments mode.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# PAYMENT_CALLBACK_URL=https://yourdomain.com/webhook/payment

# Override the default tier pricing ($25 / $50 / $100 / $1000).
# PRICES_USD={"daily":25,"weekly":50,"monthly":100,"lifetime":1000}

# Webhook listener (also serves /healthz).
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook/payment

# Your bot's @username, used to build website deep links.
BOT_USERNAME=
