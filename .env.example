# ---- required ----

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Encrypts users' Kalshi private keys at rest.
# Generate with: python -m kbot.tools genkey
# Losing this means every stored credential becomes unreadable.
MASTER_KEY=

# Telegram user IDs allowed to mint access keys. Space or comma separated.
ADMIN_IDS=

# ---- Kalshi ----

# ---- trading mode ----
#
# The ONLY thing that decides where orders go and which API host is used.
#
#   paper            simulated fills against the real PRODUCTION book. No
#                    orders are sent anywhere and no Kalshi account is needed.
#                    Liquidity is genuine, so this is the mode whose P/L means
#                    something. The default.
#   demo-live        real orders against Kalshi's demo exchange, spending the
#                    demo balance Kalshi gives you. Real signing, real fills,
#                    real rate limits. The demo book is thin, so use this to
#                    test the ORDER CODE, never to judge a strategy.
#   production-live  real orders, real money.
#
# production-live additionally requires ALLOW_PRODUCTION_ORDERS below, so no
# single edit to this file can start sending real orders.
TRADING_MODE=paper

# Required, exactly as written, before TRADING_MODE=production-live is allowed.
# It is a sentence rather than a boolean so that copying `true` from another
# variable cannot satisfy it.
# ALLOW_PRODUCTION_ORDERS=I_UNDERSTAND_THESE_ARE_REAL_ORDERS

# Kill switch. Any of these stops every order immediately:
#   - this variable set to 1/true/yes/on
#   - a file named KILL next to the database
#   - /kill from a Telegram admin
# It is read fresh before every order, never cached.
# KILL_SWITCH=0

# Deprecated: TRADING_MODE selects the host now. Setting this to a value that
# contradicts TRADING_MODE is a startup error rather than a silent winner.
# KALSHI_DEMO=false

# Platform credentials, used ONLY for the shared market-data websocket.
# Orders are always placed with each user's own key, never this one.
# Without these the bot still works, but falls back to REST order-book polling.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/market-data.pem
# ...or inline instead of a path (use \n for newlines):
# KALSHI_PRIVATE_KEY=

# Series tickers for the 15-minute up/down markets. Kalshi changes these from
# time to time — check with `python -m kbot.tools markets` and override here.
# KALSHI_SERIES={"BTC":"KXBTCD","ETH":"KXETHD","SOL":"KXSOLD"}

# Optional spot reference feed (Coinbase product IDs). Strategy input only.
# SPOT_PRODUCTS={"BTC":"BTC-USD","ETH":"ETH-USD"}

# ---- engine ----

DB_PATH=./data/kbot.sqlite3
SCAN_INTERVAL_S=1.0
DISCOVERY_INTERVAL_S=20
ORDERBOOK_POLL_INTERVAL_S=2

# Set to false to let anyone use the bot without redeeming an access key.
REQUIRE_ACCESS_KEY=true

# ---- payments ----

# "manual" (default) shows a static address and an admin runs /confirm.
# "nowpayments" creates invoices and issues keys automatically on confirmation.
PAYMENT_PROVIDER=manual

# Manual mode: the addresses buyers send to.
# MANUAL_PAY_ADDRESSES={"BTC":"bc1...","ETH":"0x...","USDT":"T...","SOL":"..."}

# NOWPayments mode.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# PAYMENT_CALLBACK_URL=https://yourdomain.com/webhook/payment

# Override the default tier pricing ($25 / $50 / $100 / $1000).
# PRICES_USD={"daily":25,"weekly":50,"monthly":100,"lifetime":1000}

# Webhook listener (also serves /healthz).
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook/payment

# Your bot's @username, used to build website deep links.
BOT_USERNAME=

# ---- results channel ----

# Channel the bot posts resolved trades to (e.g. @DirectionalResults, or the
# numeric chat ID). The bot must be an admin of the channel.
RESULTS_CHAT_ID=

# Post losing trades as well as wins. Leave this true: a feed of nothing but
# wins is not evidence, and traders notice.
RESULTS_POST_LOSSES=true

# Skip posting trades whose net is below this many cents (0 posts everything).
RESULTS_MIN_NET_CENTS=0
